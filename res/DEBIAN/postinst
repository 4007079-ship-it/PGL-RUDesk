#!/bin/bash

set -e

if [ "$1" = configure ]; then

	INITSYS=$(ls -al /proc/1/exe | awk -F' ' '{print $NF}' | awk -F'/' '{print $NF}')
	ln -f -s /usr/share/pgl-rudesk/pgl-rudesk /usr/bin/pgl-rudesk

	if [ "systemd" == "$INITSYS" ]; then

		if [ -e /etc/systemd/system/pgl-rudesk.service ]; then
			rm -f /etc/systemd/system/pgl-rudesk.service /usr/lib/systemd/system/pgl-rudesk.service /usr/lib/systemd/user/pgl-rudesk.service >/dev/null  2>&1
		fi
		mkdir -p /usr/lib/systemd/system/
		cp /usr/share/pgl-rudesk/files/systemd/pgl-rudesk.service /usr/lib/systemd/system/pgl-rudesk.service
		# try fix error in Ubuntu 18.04
		# Failed to reload pgl-rudesk.service: Unit pgl-rudesk.service is not loaded properly: Exec format error.
		# /usr/lib/systemd/system/pgl-rudesk.service:10: Executable path is not absolute: pkill -f "pgl-rudesk --"
		if [ -e /usr/bin/pkill ]; then
			sed -i "s|pkill|/usr/bin/pkill|g" /usr/lib/systemd/system/pgl-rudesk.service
		fi
		systemctl daemon-reload
		systemctl enable pgl-rudesk
		systemctl start pgl-rudesk
	fi
fi
