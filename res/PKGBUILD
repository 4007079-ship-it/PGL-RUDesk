pkgname=pgl-rudesk
pkgver=1.5.1
pkgrel=0
epoch=
pkgdesc=""
arch=('x86_64')
url=""
license=('AGPL-3.0')
groups=()
depends=('gtk3' 'xdotool' 'libxcb' 'libxfixes' 'alsa-lib' 'libva' 'libappindicator-gtk3' 'gst-plugins-base' 'gst-plugin-pipewire')
makedepends=()
checkdepends=()
optdepends=()
provides=()
conflicts=('rustdesk')
replaces=()
backup=()
options=()
install=pacman_install
changelog=
noextract=()
md5sums=() #generate with 'makepkg -g'

package() {
  if [[ ${FLUTTER} ]]; then
	  mkdir -p "${pkgdir}/usr/share/pgl-rudesk" && cp -r ${HBB}/flutter/build/linux/x64/release/bundle/* -t "${pkgdir}/usr/share/pgl-rudesk"
  fi
  mkdir -p "${pkgdir}/usr/bin"
  pushd ${pkgdir} && ln -s /usr/share/pgl-rudesk/pgl-rudesk usr/bin/pgl-rudesk && popd
  install -Dm 644 $HBB/res/pgl-rudesk.service -t "${pkgdir}/usr/share/pgl-rudesk/files"
  install -Dm 644 $HBB/res/pgl-rudesk.desktop -t "${pkgdir}/usr/share/pgl-rudesk/files"
  install -Dm 644 $HBB/res/pgl-rudesk-link.desktop -t "${pkgdir}/usr/share/pgl-rudesk/files"
  install -Dm 644 $HBB/res/128x128@2x.png "${pkgdir}/usr/share/icons/hicolor/256x256/apps/pgl-rudesk.png"
  install -Dm 644 $HBB/res/scalable.svg "${pkgdir}/usr/share/icons/hicolor/scalable/apps/pgl-rudesk.svg"
}
